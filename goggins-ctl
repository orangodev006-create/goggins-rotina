#!/bin/sh
# goggins-ctl configurar | estado | json | testar cobranca|parabens|fim_dia | fiz <tarefa> | naofiz <tarefa> | provar <tarefa> | log
# Fala com o daemon pelo D-Bus da sessão (não tem servidor HTTP).
DIR=$(dirname "$(readlink -f "$0")")
case "$1" in
  log) exec journalctl --user -u goggins -f -o cat ;;
  *) cd "$DIR" && exec python3 -m goggins.ctl "$@" ;;
esac
