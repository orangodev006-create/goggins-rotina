# goggins-rotina: criado pelo install.sh (o uninstall.sh apaga)
[Unit]
Description=Goggins - cobrança da rotina
After=plasma-workspace.target
PartOf=graphical-session.target

[Service]
WorkingDirectory=@DIR@
ExecStart=/usr/bin/python3 -u -m goggins.daemon
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
